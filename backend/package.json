{
  "name": "proasa-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --watch src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "db:migrate": "node --env-file=.env db/migrate.js",
    "db:seed": "node --env-file=.env db/migrate.js --seed",
    "admin:create": "node --env-file=.env scripts/create-admin.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "sharp": "^0.35.4"
  }
}
