API_PORT=4000
DATABASE_URL=postgres://proasa:proasa@localhost:5435/proasa
# Origen permitido para CORS (URL del frontend)
CORS_ORIGIN=http://localhost:5173
# Secreto para firmar las sesiones de administradores (cadena larga y aleatoria)
AUTH_SECRET=genera-una-cadena-larga-y-aleatoria
# Carpeta donde se guardan las fotos subidas
UPLOAD_DIR=uploads
# Proxies delante del backend: 1 = solo la plataforma de hosting, 2 = Worker de Cloudflare + plataforma
TRUST_PROXY=1
